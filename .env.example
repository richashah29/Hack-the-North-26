OPENAI_API_KEY=

# Where the corpus parquet lives. Defaults to data/corpus.parquet inside the
# repo, so you only need this if the file sits somewhere else (an external
# drive, a shared folder, a second corpus you want to A/B against).
# Relative paths resolve against the repo root, not your shell's cwd.
# CORPUS_PATH=data/corpus.parquet
# OPENAI_BASE_URL=https://api.openai.com/v1
# SENTRY_DSN=
# SENTRY_FRONTEND_DSN=
